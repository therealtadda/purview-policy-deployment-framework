{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppdf.example/schemas/kinds/RetentionLabel.schema.json",
  "title": "RetentionLabel spec",
  "description": "Retention label (ComplianceTag).",
  "type": "object",
  "required": [
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comment": {
          "type": "string",
          "maxLength": 1024
        },
        "retentionAction": {
          "enum": [
            "None",
            "Keep",
            "KeepAndDelete",
            "Delete"
          ]
        },
        "retentionDuration": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^([0-9]+|Unlimited)$",
          "minimum": 0
        },
        "retentionType": {
          "enum": [
            "CreationAgeInDays",
            "ModificationAgeInDays",
            "TaggedAgeInDays",
            "EventAgeInDays"
          ]
        },
        "isRecordLabel": {
          "type": "boolean"
        },
        "regulatory": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "reviewerEmail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "description": "Additional cmdlet parameters passed through verbatim (PascalCase)."
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skip": {
          "type": "boolean"
        },
        "scope": {
          "type": "object"
        },
        "thresholds": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(max|min|require)[A-Z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
